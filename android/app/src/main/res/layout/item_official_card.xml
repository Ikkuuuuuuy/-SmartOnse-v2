<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp">

        <!-- Circular Framed Official Portrait (Matches OfficialCard.tsx w-28 h-28 rounded-full border-4) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardOfficialPhotoBorder"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardBackgroundColor="#F59E0B"
            app:cardCornerRadius="48dp"
            app:cardElevation="4dp">

            <androidx.cardview.widget.CardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="44dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivOfficialPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Official Portrait"
                    android:scaleType="centerCrop"
                    android:src="@drawable/off_chairman" />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>

        <!-- Role Pill Badge (e.g. PUNONG BARANGAY / BARANGAY KAGAWAD / SK CHAIRPERSON) -->
        <TextView
            android:id="@+id/tvOfficialCouncil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_amber"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="PUNONG BARANGAY"
            android:textColor="#92400E"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Official Full Name -->
        <TextView
            android:id="@+id/tvOfficialName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Hon. Roberto B. Alba"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Official Designation -->
        <TextView
            android:id="@+id/tvOfficialPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="PUNONG BARANGAY (CAPTAIN)"
            android:textAllCaps="true"
            android:textColor="#9C2007"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Committee -->
        <TextView
            android:id="@+id/tvOfficialCommittee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Executive &amp; Peace and Order"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Contact Hotline Pill -->
        <TextView
            android:id="@+id/tvOfficialContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_box"
            android:fontFamily="monospace"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="📞 0917-888-0011"
            android:textColor="#334155"
            android:textSize="11.5sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
