<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D18"
    android:orientation="vertical">

    <!-- Native Top Bar with Native Kotlin Screen Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#800000"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_seal"
            android:contentDescription="Barangay Onse Seal"
            android:padding="2dp"
            android:src="@drawable/barangay_seal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMARTONSE SYSTEM"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Web UI • Sample Data Mode (No DB)"
                android:textColor="#FCD34D"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenNativeKotlin"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_gold"
            android:paddingHorizontal="10dp"
            android:text="Native Kotlin Screens"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full SmartOnse System WebView -->
    <WebView
        android:id="@+id/webViewSmartOnse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
