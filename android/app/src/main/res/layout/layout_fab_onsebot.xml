<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fabOnseBotChatbot"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="74dp"
    android:background="@drawable/bg_fab_chatbot"
    android:clickable="true"
    android:elevation="14dp"
    android:focusable="true">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:contentDescription="Open OnseBot AI Assistant"
        android:src="@drawable/ic_vec_bot" />

    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_bot_online_dot" />
</FrameLayout>
