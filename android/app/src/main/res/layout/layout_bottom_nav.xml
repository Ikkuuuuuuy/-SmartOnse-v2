<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#FFFFFF"
    android:elevation="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

    <!-- 1. HOME -->
    <LinearLayout
        android:id="@+id/bottomNavHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavHome"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="Home"
            android:src="@drawable/ic_vec_home"
            app:tint="#9C2007" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="Home"
            android:textColor="#9C2007"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indNavHome"
            android:layout_width="24dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="#9C2007" />
    </LinearLayout>

    <!-- 2. ABOUT & OFFICIALS (Merged!) -->
    <LinearLayout
        android:id="@+id/bottomNavAbout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavAbout"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="About &amp; Officials"
            android:src="@drawable/ic_vec_users"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvNavAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="About"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indNavAbout"
            android:layout_width="24dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="#9C2007"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 3. SERVICES -->
    <LinearLayout
        android:id="@+id/bottomNavServices"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavServices"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="Services"
            android:src="@drawable/ic_vec_doc"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvNavServices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="Services"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indNavServices"
            android:layout_width="28dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="#9C2007"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 4. TRANSPARENCY, SK PROGRAMS & EVENTS (Merged Community Hub!) -->
    <LinearLayout
        android:id="@+id/bottomNavTransparency"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavTransparency"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="Transparency, SK &amp; Events"
            android:src="@drawable/ic_vec_shield"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvNavTransparency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="Transparency"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indNavTransparency"
            android:layout_width="34dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="#9C2007"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 5. CONTACT & HOTLINES -->
    <LinearLayout
        android:id="@+id/bottomNavContact"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavContact"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="Contact"
            android:src="@drawable/ic_vec_building"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tvNavContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="Contact"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indNavContact"
            android:layout_width="26dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="#9C2007"
            android:visibility="invisible" />
    </LinearLayout>

</LinearLayout>
