<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SmartOnse v2 - Native Kotlin Android Application
      100% Standalone Native Kotlin Activities + XML Layouts
      Uses Predefined Static Sample Data (SampleDataRepository.kt) - No Database or Network Required
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ServicesActivity"
            android:label="Barangay E-Services"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ServiceDetailActivity"
            android:label="Service Details"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".RequestFormActivity"
            android:label="Request Certificate"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ConfirmationActivity"
            android:label="Request Confirmation"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".TrackDocumentActivity"
            android:label="Track Document"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".AboutOfficialsActivity"
            android:label="About &amp; Barangay Officials"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".TransparencySkActivity"
            android:label="Transparency, SK &amp; Events"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:label="Resident &amp; Staff Login"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".ChatbotActivity"
            android:label="OnseBot AI Assistant"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

    </application>

</manifest>
