<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF8F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Persistent Top Website Navbar + Links Strip -->
        <include layout="@layout/layout_top_navbar" />

        <!-- Page Title & Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="BARANGAY E-SERVICES CATALOG"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBackHome"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_btn_white"
                    android:paddingHorizontal="10dp"
                    android:text="← Home"
                    android:textAllCaps="false"
                    android:textColor="#9C2007"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSearchServices"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_box"
                android:hint="🔍 Search clearance, indigency, residency, business..."
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCatAll"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_maroon"
                        android:paddingHorizontal="12dp"
                        android:text="All Services"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCatGeneral"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_dark"
                        android:paddingHorizontal="12dp"
                        android:text="General &amp; Civil"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCatWelfare"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_dark"
                        android:paddingHorizontal="12dp"
                        android:text="Welfare &amp; Youth"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCatBusiness"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_btn_dark"
                        android:paddingHorizontal="12dp"
                        android:text="Business Permits"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvServicesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Showing 6 of 6 Barangay Services"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/containerServicesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="88dp" />
        </ScrollView>

        <!-- Persistent 5-Tab Bottom Navigation Bar -->
        <include layout="@layout/layout_bottom_nav" />
    </LinearLayout>

    <!-- Floating OnseBot AI Button -->
    <include layout="@layout/layout_fab_onsebot" />
</FrameLayout>
