<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Official Seal"
            android:src="@drawable/barangay_seal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOfficialCouncil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BARANGAY COUNCIL"
                android:textColor="#800000"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfficialName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hon. Roberto B. Alba"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfficialPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Chairman"
                android:textColor="#059669"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfficialCommittee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Committee: Executive &amp; Peace and Order"
                android:textColor="#475569"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvOfficialContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotline: 0917-888-0011"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
