<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#800000"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/ivBarangaySeal"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_seal"
        android:contentDescription="Barangay Onse Seal"
        android:padding="2dp"
        android:src="@drawable/barangay_seal" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.02"
        android:text="SMARTONSE"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Hamburger Menu (`☰`) for Request, Tracking, Profile, Role Switcher, Sign Out -->
    <ImageView
        android:id="@+id/btnNavbarAccount"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:clickable="true"
        android:contentDescription="Open Account &amp; Portal Menu"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_vec_menu" />

</LinearLayout>
